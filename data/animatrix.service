[Unit]
Description=Animatrix AniMe Matrix controller
Documentation=https://github.com/crt0512/animatrix
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/bin/env animatrix --minimized
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical-session.target
